{
  "$defs": {
    "ContactInfo": {
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contact email address",
          "title": "Email"
        },
        "instagram": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Instagram handle",
          "title": "Instagram"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary phone number",
          "title": "Phone"
        },
        "whatsapp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WhatsApp contact number",
          "title": "Whatsapp"
        }
      },
      "title": "ContactInfo",
      "type": "object"
    },
    "LocationInfo": {
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Street address",
          "title": "Address"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City",
          "title": "City"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude",
          "title": "Lat"
        },
        "lng": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longitude",
          "title": "Lng"
        },
        "pincode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Postal / PIN code",
          "title": "Pincode"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "State / Province",
          "title": "State"
        }
      },
      "title": "LocationInfo",
      "type": "object"
    },
    "ProductItem": {
      "properties": {
        "currency": {
          "default": "INR",
          "description": "Currency symbol or ISO code",
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Item summary",
          "title": "Description"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to product image",
          "title": "Image Url"
        },
        "is_suggested": {
          "default": false,
          "description": "Whether product was automatically suggested",
          "title": "Is Suggested",
          "type": "boolean"
        },
        "name": {
          "description": "Name of the product or service",
          "title": "Name",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Price in designated currency",
          "title": "Price"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProductItem",
      "type": "object"
    },
    "StoreCategory": {
      "enum": [
        "food",
        "apparel",
        "electronics",
        "pharmacy",
        "services"
      ],
      "title": "StoreCategory",
      "type": "string"
    }
  },
  "properties": {
    "category": {
      "$ref": "#/$defs/StoreCategory",
      "description": "Retail business category"
    },
    "contact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContactInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Contact info"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "",
      "description": "Tagline or store description",
      "title": "Description"
    },
    "hours": {
      "description": "Formatted opening hours",
      "items": {
        "type": "string"
      },
      "title": "Hours",
      "type": "array"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocationInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Store location"
    },
    "products": {
      "description": "Extracted product list",
      "items": {
        "$ref": "#/$defs/ProductItem"
      },
      "title": "Products",
      "type": "array"
    },
    "shop_name": {
      "description": "Name of the retail storefront",
      "minLength": 1,
      "title": "Shop Name",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source of the spec: 'groq' or 'fallback'",
      "title": "Source"
    }
  },
  "required": [
    "shop_name",
    "category"
  ],
  "title": "StorefrontSpec",
  "type": "object"
}
