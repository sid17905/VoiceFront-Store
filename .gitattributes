# Normalise line endings so diffs are reviewable.
* text=auto eol=lf

# Source
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.dart text eol=lf
*.jinja2 text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.tf text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Shell and platform scripts keep their native convention where required.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries — never diff, never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
*.jar binary
*.ttf binary
*.woff binary
*.woff2 binary
