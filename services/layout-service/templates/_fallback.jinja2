<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop_name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta property="og:title" content="{{ shop_name }}">
  <meta property="og:type" content="website">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {{ json_ld }}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: {{ colors.text }};
      background: {{ colors.background }};
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .mobile-container {
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      background: #ffffff;
      box-shadow: 0 0 25px rgba(0,0,0,0.08);
      display: flex;
      flex-direction: column;
    }
    a, button { min-width: 24px; min-height: 24px; }
    a:focus-visible { outline: 2px solid {{ colors.accent }}; outline-offset: 2px; }
    .app-bar {
      background: linear-gradient(135deg, {{ colors.primary }}, {{ colors.secondary }});
      color: #ffffff;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .app-bar h1 { font-size: 1.2rem; font-weight: 700; }
    .badge { background: rgba(255,255,255,0.2); padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .hero-section {
      position: relative;
      background: {{ colors.secondary }};
      padding: 48px 20px;
      text-align: center;
      color: #ffffff;
    }
    .hero-content h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 8px; }
    .hero-content p { font-size: 0.95rem; opacity: 0.95; max-width: 320px; margin: 0 auto; }
    .content-body { padding: 24px 16px; flex: 1; }
    .section-title { font-size: 1.1rem; font-weight: 700; color: {{ colors.primary }}; margin-bottom: 16px; }
    .product-grid { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
    .product-card {
      background: #ffffff;
      border: 1px solid #edf2f7;
      border-radius: 14px;
      padding: 16px;
      display: flex;
      gap: 14px;
      align-items: center;
    }
    .product-thumb { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
    .product-info { flex: 1; }
    .product-info h3 { font-size: 1rem; font-weight: 600; color: #1e293b; margin-bottom: 4px; }
    .product-info .desc { font-size: 0.8rem; color: #475569; margin-bottom: 6px; }
    .product-info .price { font-size: 1rem; font-weight: 700; color: {{ colors.accent }}; }
    .info-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 24px; }
    .info-card ul { list-style: none; }
    .info-card li { padding: 6px 0; font-size: 0.85rem; color: #334155; border-bottom: 1px solid #f1f5f9; }
    .info-card li:last-child { border-bottom: none; }
    .cta-footer { background: #ffffff; padding: 16px; border-top: 1px solid #e2e8f0; position: sticky; bottom: 0; z-index: 100; }
    .whatsapp-btn {
      background: #128c4b;
      color: #ffffff;
      text-decoration: none;
      padding: 14px 20px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 48px;
    }
    footer { text-align: center; padding: 16px; font-size: 0.75rem; color: #475569; background: #f8fafc; }
  </style>
</head>
<body>
  <div class="mobile-container">
    <header class="app-bar">
      <h1>{{ shop_name }}</h1>
      <span class="badge">{{ category }}</span>
    </header>

    <main class="content-body">
      <section class="hero-section" aria-label="About">
        <div class="hero-content">
          <h2>{{ shop_name }}</h2>
          {% if description %}<p>{{ description }}</p>{% endif %}
        </div>
      </section>

      {% if products %}
      <section aria-labelledby="products-heading">
        <h2 class="section-title" id="products-heading">Featured Catalog</h2>
        <div class="product-grid">
          {% for p in products %}
          <article class="product-card">
            <img src="{{ p.thumbnail }}" class="product-thumb" alt="{{ p.name }}" width="72" height="72">
            <div class="product-info">
              <h3>{{ p.name }}</h3>
              {% if p.description %}<div class="desc">{{ p.description }}</div>{% endif %}
              <div class="price">{{ p.price_display }}</div>
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if hours %}
      <section aria-labelledby="hours-heading">
        <h2 class="section-title" id="hours-heading">Operating Hours</h2>
        <div class="info-card"><ul>
          {% for h in hours %}<li>{{ h }}</li>{% endfor %}
        </ul></div>
      </section>
      {% endif %}

      {% if location_display or contact.phone %}
      <section aria-labelledby="contact-heading">
        <h2 class="section-title" id="contact-heading">Location &amp; Details</h2>
        <div class="info-card"><ul>
          {% if location_display %}<li><strong>Address:</strong> {{ location_display }}</li>{% endif %}
          {% if contact.phone %}<li><strong>Phone:</strong> {{ contact.phone }}</li>{% endif %}
        </ul></div>
      </section>
      {% endif %}
    </main>

    {% if whatsapp_number %}
    <div class="cta-footer">
      <a href="https://wa.me/{{ whatsapp_number }}" class="whatsapp-btn" rel="noopener">Order / Book via WhatsApp</a>
    </div>
    {% endif %}

    <footer>
      <p>{{ shop_name }} &bull; Powered by VoiceFront Engine</p>
    </footer>
  </div>
</body>
</html>
