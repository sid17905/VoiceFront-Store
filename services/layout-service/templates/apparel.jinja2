<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop_name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Georgia', serif; color: {{ colors.text }}; background: {{ colors.background }}; line-height: 1.6; }
    a, button { min-width: 24px; min-height: 24px; display: inline-flex; align-items: center; justify-content: center; }

    .nav { background: {{ colors.primary }}; color: #fff; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
    .nav h1 { font-size: 1.4rem; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; }
    .nav-links { display: flex; gap: 24px; }
    .nav-links a { color: #fff; text-decoration: none; font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase; }
    .nav-links a:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

    .hero { background: {{ colors.secondary }}; padding: 48px 24px; text-align: center; }
    .hero h2 { font-size: 1.8rem; font-weight: 400; letter-spacing: 1px; margin-bottom: 12px; color: {{ colors.primary }}; }
    .hero p { max-width: 560px; margin: 0 auto; font-size: 1rem; color: {{ colors.text }}; }

    .products { padding: 32px 24px; max-width: 1100px; margin: 0 auto; }
    .products h2 { font-size: 1.3rem; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 24px; text-align: center; color: {{ colors.primary }}; }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
    .product-card { border: 1px solid #e8e8e8; padding: 20px; background: #fff; text-align: center; }
    .product-card h3 { font-size: 1rem; font-weight: 400; letter-spacing: 0.5px; margin-bottom: 8px; }
    .product-card .price { font-size: 1.15rem; font-weight: 600; color: {{ colors.accent }}; }
    .product-card .desc { font-size: 0.85rem; color: #888; margin-top: 8px; font-style: italic; }

    .hours { padding: 32px 24px; max-width: 600px; margin: 0 auto; text-align: center; }
    .hours h2 { font-size: 1.3rem; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px; color: {{ colors.primary }}; }
    .hours ul { list-style: none; }
    .hours li { padding: 8px 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }

    .contact { padding: 32px 24px; text-align: center; }
    .contact h2 { font-size: 1.3rem; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px; color: {{ colors.primary }}; }
    .contact-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }
    .whatsapp-btn { background: #25D366; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 4px; font-size: 0.9rem; letter-spacing: 0.5px; }
    .whatsapp-btn:hover { background: #1da851; }
    .phone-link { color: {{ colors.primary }}; text-decoration: underline; padding: 12px 0; font-size: 0.9rem; }

    footer { text-align: center; padding: 32px 24px; font-size: 0.8rem; color: #bbb; border-top: 1px solid #eee; margin-top: 40px; letter-spacing: 1px; }

    @media (max-width: 480px) {
      .product-grid { grid-template-columns: 1fr 1fr; }
      .nav { flex-direction: column; gap: 12px; }
    }
  </style>
  {{ json_ld }}
</head>
<body>
  <main>
  <nav class="nav" aria-label="Main navigation">
    <h1>{{ shop_name }}</h1>
    <div class="nav-links">
      <a href="#products">Collection</a>
      <a href="#hours">Hours</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  {% if description %}
  <section class="hero" aria-label="About us">
    <h2>{{ shop_name }}</h2>
    <p>{{ description }}</p>
  </section>
  {% endif %}

  <section class="products" id="products" aria-label="Products">
    <h2>Our Collection</h2>
    <div class="product-grid">
      {% for product in products %}
      <div class="product-card">
        <h3>{{ product.name }}</h3>
        <p class="price">{{ product.price_display }}</p>
        {% if product.description %}
        <p class="desc">{{ product.description }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  {% if hours %}
  <section class="hours" id="hours" aria-label="Opening hours">
    <h2>Store Hours</h2>
    <ul>
      {% for h in hours %}
      <li>{{ h }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="contact" id="contact" aria-label="Contact information">
    <h2>Contact Us</h2>
    <div class="contact-links">
      {% if contact.whatsapp %}
      <a class="whatsapp-btn" href="https://wa.me/{{ contact.whatsapp }}" target="_blank" rel="noopener">Chat on WhatsApp</a>
      {% endif %}
      {% if contact.phone %}
      <a class="phone-link" href="tel:{{ contact.phone }}">{{ contact.phone }}</a>
      {% endif %}
    </div>
    {% if location %}
    <p style="margin-top: 12px; font-size: 0.9rem;">📍 {{ location_display }}</p>
    {% endif %}
  </section>

  <footer>
    <p>{{ shop_name }} &mdash; Powered by VoiceFront</p>
  </footer>
  </main>
</body>
</html>
