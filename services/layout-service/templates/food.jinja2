<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop_name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: {{ colors.text }}; background: {{ colors.background }}; line-height: 1.6; }
    a, button { min-width: 24px; min-height: 24px; display: inline-flex; align-items: center; justify-content: center; }
    img { max-width: 100%; height: auto; display: block; }

    .nav { background: {{ colors.primary }}; color: #fff; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .nav h1 { font-size: 1.25rem; font-weight: 700; }
    .nav-links { display: flex; gap: 16px; }
    .nav-links a { color: #fff; text-decoration: none; font-size: 0.9rem; padding: 4px 0; }
    .nav-links a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 2px; }

    .hero { background: {{ colors.secondary }}; padding: 32px 16px; text-align: center; }
    .hero h2 { font-size: 1.5rem; color: {{ colors.primary }}; margin-bottom: 8px; }
    .hero p { max-width: 600px; margin: 0 auto; color: {{ colors.text }}; }

    .products { padding: 24px 16px; max-width: 1000px; margin: 0 auto; }
    .products h2 { font-size: 1.25rem; margin-bottom: 16px; color: {{ colors.primary }}; }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
    .product-card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; background: #fff; }
    .product-card h3 { font-size: 1rem; margin-bottom: 4px; }
    .product-card .price { font-size: 1.1rem; font-weight: 700; color: {{ colors.accent }}; }
    .product-card .desc { font-size: 0.85rem; color: #666; margin-top: 4px; }

    .hours { padding: 24px 16px; max-width: 1000px; margin: 0 auto; }
    .hours h2 { font-size: 1.25rem; margin-bottom: 12px; color: {{ colors.primary }}; }
    .hours ul { list-style: none; }
    .hours li { padding: 6px 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }

    .contact { padding: 24px 16px; max-width: 1000px; margin: 0 auto; }
    .contact h2 { font-size: 1.25rem; margin-bottom: 12px; color: {{ colors.primary }}; }
    .contact-links { display: flex; flex-wrap: wrap; gap: 12px; }
    .whatsapp-btn { background: #25D366; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; }
    .whatsapp-btn:hover { background: #1da851; }
    .phone-link { color: {{ colors.primary }}; text-decoration: underline; padding: 10px 0; }

    footer { text-align: center; padding: 24px 16px; font-size: 0.8rem; color: #999; border-top: 1px solid #eee; margin-top: 32px; }

    @media (max-width: 480px) {
      .product-grid { grid-template-columns: 1fr; }
      .nav { flex-direction: column; text-align: center; }
    }
  </style>
  {{ json_ld }}
</head>
<body>
  <main>
  <nav class="nav" aria-label="Main navigation">
    <h1>{{ shop_name }}</h1>
    <div class="nav-links">
      <a href="#products">Menu</a>
      <a href="#hours">Hours</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  {% if description %}
  <section class="hero" aria-label="About us">
    <h2>Welcome to {{ shop_name }}</h2>
    <p>{{ description }}</p>
  </section>
  {% endif %}

  <section class="products" id="products" aria-label="Products">
    <h2>Our Menu</h2>
    <div class="product-grid">
      {% for product in products %}
      <div class="product-card"><img src="{{ product.thumbnail }}" alt="" loading="lazy" style="width:100%;height:140px;object-fit:cover;border-radius:6px;margin-bottom:8px">
        <h3>{{ product.name }}</h3>
        <p class="price">{{ product.price_display }}</p>
        {% if product.description %}
        <p class="desc">{{ product.description }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>

  {% if hours %}
  <section class="hours" id="hours" aria-label="Opening hours">
    <h2>Hours</h2>
    <ul>
      {% for h in hours %}
      <li>{{ h }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="contact" id="contact" aria-label="Contact information">
    <h2>Get in Touch</h2>
    <div class="contact-links">
      {% if contact.whatsapp %}
      <a class="whatsapp-btn" href="https://wa.me/{{ contact.whatsapp }}" target="_blank" rel="noopener">WhatsApp Us</a>
      {% endif %}
      {% if contact.phone %}
      <a class="phone-link" href="tel:{{ contact.phone }}">📞 {{ contact.phone }}</a>
      {% endif %}
    </div>
    {% if location %}
    <p style="margin-top: 12px; font-size: 0.9rem;">📍 {{ location_display }}</p>
    {% endif %}
  </section>

  <footer>
    <p>{{ shop_name }} &mdash; Powered by VoiceFront</p>
  </footer>
  </main>
</body>
</html>
