# VoiceFront Layout Service — Environment Variables
# Copy this file to .env and fill in values.

# Directory containing Jinja2 template files (*.jinja2)
# Default: services/layout-service/templates/
LAYOUT_TEMPLATE_DIR=

# Comma-separated list of supported categories
# Default: food,apparel,electronics,pharmacy,services
LAYOUT_CATEGORIES=food,apparel,electronics,pharmacy,services
