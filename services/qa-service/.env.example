# services/qa-service/.env.example — copy to .env, per environment.md

# Global (packages/common-utils/config.py)
ENV=development
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql://postgres:dev@localhost:5432/voicestorefront
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=your-personal-free-tier-key-here

# qa-service specific
QA_FAISS_INDEX_PATH=./data/faiss_index
QA_SIMILARITY_THRESHOLD=0.87
QA_GROQ_MODEL=llama-3.1-8b-instant
QA_MAX_REPAIR_LATENCY_MS=800
QA_VIEWPORT_WIDTHS=320,375,768,1024,1440
